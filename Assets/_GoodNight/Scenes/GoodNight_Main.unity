  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3f0fcf4b56fae54e936c7c4bf069451, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GNight.Inspectable
  id: isolationDoc
  titleEs: "Manual GUARDI\xC1N"
  titleEn: GUARDIAN manual
  textEs: "\xABAislamiento: sella una zona. Lo que queda dentro no sale.\n\xB7 Un
    sensor que parpadea a ritmo fijo es un ECO.\n\xB7 Una c\xE1mara con REC y una
    hora vieja est\xE1 CONGELADA.\n\xB7 A\xEDsle solo lo que confirmen un sensor
    estable y una c\xE1mara en DIRECTO.\n\xB7 Requiere ALARMA + C\xC1MARAS + CERRADURAS.\xBB"
  textEn: "\"Isolation: seals a zone. Whatever stays inside doesn't come out.\n\xB7
    A sensor blinking at a steady rhythm is an ECHO.\n\xB7 A camera showing REC and
    an old time is FROZEN.\n\xB7 Only isolate what a steady sensor AND a LIVE camera
    confirm.\n\xB7 Requires ALARM + CAMERAS + LOCKS.\""
  backTextEs: 
  backTextEn: 
  verbEs: Leer
  verbEn: Read
  visual: {fileID: 0}
  presentEuler: {x: 0, y: 0, z: 0}
  targetSize: 0.34
  collect: 0
  invNameEs: 
  invNameEn: 
  isDocument: 1
  clueId: 
  clueEs: 
  clueEn: 
  clueOnBack: 0
  available: 1
  seen: 0
  seenBack: 0
