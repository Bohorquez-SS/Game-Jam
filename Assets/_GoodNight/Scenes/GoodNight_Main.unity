  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3f0fcf4b56fae54e936c7c4bf069451, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GNight.Inspectable
  id: fatherNotes
  titleEs: "Notas de pap\xE1"
  titleEn: Dad's notes
  textEs: "\xABD\xEDa 31. La casa no deja entrar a nadie: los HACE. Aparecen en una
    habitaci\xF3n sin cruzar ninguna puerta. Una copia no recuerda haber llegado;
    recuerda haber estado siempre. Si GUARDI\xC1N cuenta dos... uno de ellos no naci\xF3.
    (D\xEDa 4: el primero sali\xF3 mal. S-0. Sin cara. Imita la voz de M. No le abras.)\xBB"
  textEn: '"Day 31. The house doesn''t let anyone in: it MAKES them. They appear
    in a room without crossing any door. A copy doesn''t remember arriving; it remembers
    having always been there. If GUARDIAN counts two... one of them was never born.
    (Day 4: the first one went wrong. S-0. No face. It imitates M''s voice. Don''t
    open the door to it.)"'
  backTextEs: 
  backTextEn: 
  verbEs: Leer
  verbEn: Read
  visual: {fileID: 0}
  presentEuler: {x: 0, y: 0, z: 0}
  targetSize: 0.34
  collect: 0
  invNameEs: 
  invNameEn: 
  isDocument: 1
  clueId: 
