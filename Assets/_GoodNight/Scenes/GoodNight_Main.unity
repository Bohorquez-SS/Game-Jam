  content:
    id: receipt
    titleEs: "Recibo de cerrajer\xEDa"
    titleEn: Locksmith receipt
    bodyEs: "CERRAJER\xCDA SAN LUIS\nCambio de cerradura \u2014 puerta principal\nFecha
      del trabajo: 23 de agosto\nTotal: Bs 180\n\nAl pie, con la letra de mam\xE1:
      \"c\xF3digo nuevo = d\xEDa del cambio\"."
    bodyEn: "SAN LUIS LOCKSMITHS\nLock replacement \u2014 front door\nDate of work:
      August 23\nTotal: Bs 180\n\nAt the bottom, in Mom's handwriting: \"new code
      = day of the change\"."
    image: {fileID: 2800000, guid: 8d568adec0d3986409a7ad0336f07af8, type: 3}
  clueId: pin
  clueEs: "Recibo del cerrajero: cerradura cambiada el 23 de agosto \u2192 PIN 2308
    (DDMM)."
  clueEn: "Locksmith receipt: lock changed on August 23 \u2192 PIN 2308 (DDMM)."
