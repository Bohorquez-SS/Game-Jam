  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GNight.Inspectable
  id: receipt
  titleEs: Recibo del cerrajero
  titleEn: Locksmith receipt
  textEs: "\xABCerrajer\xEDa Ram\xEDrez \u2014 Cambio de cerradura y cerrojo interior.
    Fecha: 23/08.\xBB Hay algo escrito atr\xE1s."
  textEn: "\"Ram\xEDrez Locksmiths \u2014 Lock and inner deadbolt replacement. Date:
    23/08.\" There's something written on the back."
  backTextEs: "Con la letra de mam\xE1: \xABNuevo PIN de la alarma = d\xEDa y mes
    del cambio de cerradura. No lo anotes en ning\xFAn otro lado.\xBB"
  backTextEn: 'In mom''s handwriting: "New alarm PIN = day and month of the lock
    change. Don''t write it anywhere else."'
  verbEs: Leer
  verbEn: Read
  visual: {fileID: 0}
  presentEuler: {x: 0, y: 0, z: 0}
  targetSize: 0.34
  collect: 1
  invNameEs: Recibo
  invNameEn: Receipt
  isDocument: 1
  clueId: pin
  clueEs: "PIN de la alarma: 2308 (d\xEDa en que cambiaron la cerradura)."
  clueEn: 'Alarm PIN: 2308 (the day the lock was changed).'
  clueOnBack: 1
  available: 0
  seen: 0
  seenBack: 0
