# ============================================================
#  GOOD NIGHT · .gitignore para Unity 6.3 (URP)
#  Se suben: Assets/, Packages/, ProjectSettings/ (con todos los .meta),
#  documentación y Tools/. NO se suben carpetas que Unity regenera.
# ============================================================

# --- Carpetas que Unity genera solo ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
.utmp/

# --- Compilaciones del juego (el ejecutable va a itch.io, no a GitHub) ---
/[Bb]uild/
/[Bb]uilds/
/GoodNight/
/UnityGoodNight/
*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.app
*.exe
*.unitypackage
*.unitypackage.meta

# --- ZIP de trabajo y respaldos locales ---
*.zip
*.tgz
*.tar
*.rar
*.7z
/_backups*/
/_respaldos/
/_descargas/
/_claude_sync/
/QA_Snapshots/

# --- IDEs ---
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# --- Metas de archivos de depuración (los demás .meta SÍ se suben) ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Blender: copias automáticas ---
*.blend1
*.blend1.meta

# --- Basura del sistema y de Unity ---
*.log
sysinfo.txt
mono_crash.*
crashlytics-build.properties
Thumbs.db
desktop.ini
.DS_Store
/[Aa]ssets/[Ss]ceneDependencyCache*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
InitTestScene*.unity*

# --- Credenciales (nunca se suben) ---
.env
*.pem
*.key
*.keystore
