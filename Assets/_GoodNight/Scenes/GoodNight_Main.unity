  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GNight.VCRStation
  stationId: vcr
  view: {fileID: 2124991802}
  promptEs: Usar videograbadora
  promptEn: Use VCR
  available: 1
  canExit: 1
  tv: {fileID: 1560400208}
  tapes:
  - id: tape_a
    letter: A
    stamp: 22:47
    dateLabel: "S\xC1B 23:59"
    cam: {fileID: 1508410069}
    actors: {fileID: 194154949}
    actor: {fileID: 296047233}
    clueEs: "Cinta A (22:47): el chico que lleg\xF3 a las 22:10 est\xE1 en la cocina.
      Se sirve agua. Mira hacia el pasillo, como si oyera algo."
    clueEn: 'Tape A (22:47): the boy who arrived at 22:10 is in the kitchen. He pours
      some water. He looks toward the hallway, as if he heard something.'
    duration: 14
    box: {fileID: 978833044}
  - id: tape_b
    letter: B
    stamp: 01:24
    dateLabel: "S\xC1B 23:59"
    cam: {fileID: 2054070313}
    actors: {fileID: 603517918}
    actor: {fileID: 279738248}
    clueEs: "Cinta B (01:24): el pasillo. Una figura con mi ropa camina hacia la
      c\xE1mara y se detiene. Pero la cinta marca una hora que todav\xEDa no pas\xF3."
    clueEn: 'Tape B (01:24): the hallway. A figure in my clothes walks toward the
      camera and stops. But the tape shows a time that hasn''t happened yet.'
    duration: 14
    box: {fileID: 1608307365}
  - id: tape_c
    letter: C
    stamp: 22:10
    dateLabel: "S\xC1B 23:59"
    cam: {fileID: 1609758610}
    actors: {fileID: 1782080926}
    actor: {fileID: 1097000189}
    clueEs: "Cinta C (22:10): alguien igual a m\xED llega por el camino, abre la
      puerta principal con su llave y entra."
    clueEn: 'Tape C (22:10): someone identical to me walks up the path, opens the
      front door with his key and comes in.'
    duration: 14
    box: {fileID: 835858491}
  slot: {fileID: 1308752017}
  ejectBtn: {fileID: 2003912000}
